# Server-only PostgreSQL URL from Supabase Dashboard → Connect.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Public origin of this Next.js application, not your Supabase API URL.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Booking notification email. Configure a verified sender; without it, email is not delivered.
RESEND_API_KEY=
EMAIL_FROM=
# Professional scheduled-report runner. 32+ random characters; call POST /api/internal/run-reports with Bearer token.
# Leave unset to disable. A deployment scheduler and verified sender are separate prerequisites.
REPORT_RUNNER_SECRET=
# Business reminder/tag scheduler. 32+ random characters; call POST /api/internal/run-business-automations
# with a Bearer token. Leave unset to disable. Requires a deployment scheduler.
BUSINESS_AUTOMATION_RUNNER_SECRET=
# Development-only WhatsApp simulator; SUCCESS, FAILURE, or DELAYED. Never sends real messages.
# Disabled in production even if set. Live Meta Cloud API and consent capture are not configured.
WHATSAPP_DEV_MODE=
# Temporary first-confirmation grace above Starter's 200 included bookings (0-20).
STARTER_BOOKING_GRACE_PERCENT=10

# Development-only simulator. Never enable against the connected main project.
ENABLE_TEST_PAYMENTS=false
# Set a unique server-only secret on a disposable development database when testing.
TEST_PAYMENT_WEBHOOK_SECRET=
# ToyyibPay sandbox only. Set scope to ALL_TEST_VENUES to share one test account; never use that for live payments.
ENABLE_TOYYIBPAY_SANDBOX=false
TOYYIBPAY_SANDBOX_SCOPE=
TOYYIBPAY_SANDBOX_ORGANIZATION_ID=
TOYYIBPAY_SANDBOX_SECRET_KEY=
TOYYIBPAY_SANDBOX_CATEGORY_CODE=
# Set a different server-only secret and schedule POST /api/internal/expire-payment-holds for online rollout.
PAYMENT_HOLD_SWEEP_SECRET=
