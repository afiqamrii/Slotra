# CORE — store real secrets in environment-scoped secret storage, never Git.
DEPLOYMENT_ENV=development
NEXT_PUBLIC_PRODUCT_NAME=Slotra
NEXT_PUBLIC_COMPANY_NAME=Nexura Labs
NEXT_PUBLIC_BRAND_ACCENT=#176b5b
SUPPORT_EMAIL=

# DATABASE — server only. Staging and production must use different Supabase projects.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
EXPECTED_DATABASE_FINGERPRINT=
PRODUCTION_DATABASE_FINGERPRINT=
MIGRATION_DATABASE_URL=
MIGRATION_TARGET_FINGERPRINT=
ALLOW_PRODUCTION_MIGRATIONS=false
ALLOW_DEV_SEED=false
ALLOW_REMOTE_DEV_SEED=false
SEED_DATABASE_FINGERPRINT=

# AUTH
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Transactional email. EMAIL_FROM must use a sender domain verified in Resend.
# Example: Slotra <hello@updates.example.com>. EMAIL_REPLY_TO must be a plain mailbox address.
# Without valid configuration, development records previews and production records failures; neither claims delivery.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Exact comma-separated addresses; staging sends only to recipients listed here.
STAGING_EMAIL_ALLOWLIST=
# Development-only WhatsApp simulator; SUCCESS, FAILURE, or DELAYED. Never sends real messages.
# Disabled in production even if set. Live Meta Cloud API and consent capture are not configured.
WHATSAPP_DEV_MODE=
# Temporary first-confirmation grace above Starter's 200 included bookings (0-20).
STARTER_BOOKING_GRACE_PERCENT=10

# Development-only simulator. Never enable against the connected main project.
ENABLE_TEST_PAYMENTS=false
# Set a unique server-only secret on a disposable development database when testing.
TEST_PAYMENT_WEBHOOK_SECRET=
# ToyyibPay sandbox only. Set scope to ALL_TEST_VENUES to share one test account; never use that for live payments.
ENABLE_TOYYIBPAY_SANDBOX=false
TOYYIBPAY_SANDBOX_SCOPE=
TOYYIBPAY_SANDBOX_ORGANIZATION_ID=
TOYYIBPAY_SANDBOX_SECRET_KEY=
TOYYIBPAY_SANDBOX_CATEGORY_CODE=

# SaaS subscriptions (venue pays Slotra), separate from venue booking payments.
SAAS_TRIAL_DAYS=14
SAAS_GRACE_DAYS=5
# Enable only for development test venues. Always disabled when NODE_ENV=production.
ENABLE_DEV_SUBSCRIPTIONS=false
DEV_SUBSCRIPTION_WEBHOOK_SECRET=

# STORAGE — private, dedicated branding bucket. The secret key is server only.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_BRANDING_BUCKET=
STAGING_STORAGE_PROJECT_REF=

# JOBS — one protected Vercel Cron dispatcher.
CRON_SECRET=
ENABLE_SCHEDULED_JOBS=false
ALLOW_STAGING_JOBS=false

# MONITORING — optional hosted Sentry project DSN.
SENTRY_DSN=

# DOMAINS — production derives all first-party origins from one validated root.
# Example production value: your-product-domain.com (no scheme or path). Leave blank when using explicit development/staging origins.
NEXT_PUBLIC_PRODUCT_DOMAIN=
# Development and staging may use explicit origins. If supplied in production, they must match the derived product-domain origins.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BOOKING_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
CUSTOM_DOMAINS_ENABLED=false
CUSTOM_DOMAIN_READY_HOSTS=

# OPTIONAL
BOOKING_QR_SECRET=
SLOTRA_WEBHOOK_SIGNING_KEY=
SMOKE_BASE_URL=http://localhost:3000
SMOKE_VENUE_SLUG=
